    "predeploy": "npm run build",
    "deploy": "npx --yes gh-pages@6 -d dist"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-globe.gl": "^2.38.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
