{
  "name": "travel-history",
  "version": "0.2.0",
  "homepage": "https://thedylone.github.io/travel-history",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
