{
  "name": "travel-globe",
  "version": "0.4.0",
  "description": "Your trips and photos on an interactive 3D globe, built from a folder of YAML files",
  "license": "MIT",
  "homepage": "https://github.com/thedylone/travel-globe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedylone/travel-globe.git"
  },
  "private": true,
  "type": "module",
  "bin": {
    "travel-globe": "bin/travel-globe.js",
    "travel-history": "bin/travel-globe.js"
  },
  "files": [
    "LICENSE",
    "bin",
    "example",
    "index.html",
    "studio.html",
    "public",
    "scripts",
    "!scripts/**/*.test.ts",
    "src",
    "!src/**/*.test.ts",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx scripts/cli.ts dev",
    "studio": "tsx scripts/cli.ts studio",
    "build": "tsc --noEmit && tsx scripts/cli.ts build",
    "stats-image": "tsx scripts/cli.ts stats-image",
    "preview": "tsx scripts/cli.ts preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsx scripts/cli.ts check",
    "photos": "tsx scripts/cli.ts photos",
    "import": "tsx scripts/cli.ts import",
    "predeploy": "npm run build",
    "deploy": "npx --yes gh-pages@6 -d dist",
    "perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "d3-geo": "^3.1.1",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-globe.gl": "^2.38.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "1.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "playwright": "1.56.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
